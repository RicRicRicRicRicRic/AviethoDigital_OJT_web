---
import { IMAGES } from '../../data/assets.js';
const services = IMAGES.page_services;
const icons = IMAGES.icon;
---

<div class="container">
  <div class="top-div">
    <div class="box active" id="ls-box-1">
      <img src={services.ls_sms.src} alt="Social Media and General Purpose Live Streaming" />
      <div class="content"><h1>Social Media and General Purpose Live Streaming</h1><p>Assembling and organizing footage, cutting, and sequencing to create a polished final product.</p></div>
    </div>
    <div class="box" id="ls-box-2">
      <img src={services.ls_gg.src} alt="Gaming and Interactive Streaming" />
      <div class="content"><h1>Gaming and Interactive Streaming</h1><p>Specialized streaming services for gaming content and interactive experiences with professional quality and audience engagement.</p></div>
    </div>
    <div class="box" id="ls-box-3">
      <img src={services.ls_bus.src} alt="Professional and Business Streaming" />
      <div class="content"><h1>Professional and Business Streaming</h1><p>Webinars, virtual meetings, and corporate events streamed with high production value and technical reliability.</p></div>
    </div>
    <div class="box" id="ls-box-4">
      <img src={services.ls_ent.src} alt="Enterprise and High-Scale Event Streaming" />
      <div class="content"><h1>Enterprise and High-Scale Event Streaming</h1><p>Large-scale streaming solutions for major corporate events, conferences, and product launches with global reach.</p></div>
    </div>
  </div>
  
  <div class="bottom-div">
    <button class="active-btn" onclick="showBox('ls-box-1', this)"><img src={icons.icon_ls_live.src} /></button>
    <button onclick="showBox('ls-box-2', this)"><img src={icons.icon_ls_gg.src} /></button>
    <button onclick="showBox('ls-box-3', this)"><img src={icons.icon_ls_bus.src} /></button>
    <button onclick="showBox('ls-box-4', this)"><img src={icons.icon_ls_ent.src} /></button>
  </div>
</div>


<script is:inline>
  function showBox(boxId, btnElement) {
    const boxes = document.querySelectorAll('.box');
    boxes.forEach(box => box.classList.remove('active'));
    const buttons = document.querySelectorAll('.bottom-div button, .nav-buttons button');
    buttons.forEach(btn => btn.classList.remove('active-btn'));
    btnElement.classList.add('active-btn');
    requestAnimationFrame(() => {
      const target = document.getElementById(boxId);
      if (target) target.classList.add('active');
    });
  }
</script>

<style>
  .container { 
    display: flex; flex-direction: column; gap: 20px; padding: 20px; align-items: center; 

    .top-div { 
      width: 100%; height: 400px !important; position: relative; overflow: hidden; 

      .box {
        box-sizing: border-box; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff;
        display: flex; border-radius: 10px; overflow: hidden;
        opacity: 0; transform: translateX(20px); pointer-events: none; z-index: 1;
        transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
        border: 1px solid #ddd;

        &.active { opacity: 1; transform: translateX(0); pointer-events: auto; z-index: 2; }

        &:not(.active) { transform: translateX(-20px); }

        img { width: 50%; height: 100%; object-fit: cover; }

        .content { 
          width: 50%; padding: 20px; display: flex; flex-direction: column; justify-content: center; 
          background-color: #252728; 
          padding-right: 20px;
          h1 { color: #ffaa66 !important; } 
          p {color: #94a3b8;}
          
        }
      }
    }

    .bottom-div { 
      display: flex; gap: 30px; height: 100px; align-items: center; 

      button {
        padding: 35px; cursor: pointer; height: 60px; width: 60px;
        background:#ffaa66 ; border: 3px solid #ffaa66; border-radius: 40px;
        transition: all 0.3s ease; display: flex; align-items: center; justify-content: center;

        img { 
          width: 40px; height: 40px; object-fit: contain; filter: brightness(0) invert(1); transition: filter 0.3s ease;
        }
      }

      button.active-btn {
        background: rgba(255, 170, 102, 0.3); border: 3px solid #ffaa66;
        img { filter: brightness(1) invert(0); }
      }

      button:hover {
        background: #ffaa66; box-shadow: 0 0 15px #ffaa66;
        img { filter: brightness(1) invert(0); }
      }
    }
  }
</style>