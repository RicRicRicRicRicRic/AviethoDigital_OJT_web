---
import { IMAGES } from '../../data/assets.js';
---
<script>
  function initBox3Slideshow() {
    const track3 = document.getElementById('box3-track');
    const buttons3 = document.querySelectorAll('.control-btn');
    buttons3.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIndex = btn.getAttribute('data-slide');
        
        if (track3) {
          track3.style.transform = `translateX(-${Number(targetIndex) * 100}%)`;
        }

        buttons3.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initBox3Slideshow);
</script>

<div class="box box-3" style={`background-image: url(${IMAGES.websool.heroBg3.src});`}>
  <div class="glass-overlay">
    <div class="column column-left">
      <h1>Complete Web Solutions</h1>
      <p class="theme-text">From design to deployment, we provide comprehensive website development services that drive results.</p>
    </div>
    
    <div class="column column-middle">
      <div class="gif-wrapper">
        <img src={IMAGES.gif_webDev?.src} alt="Web Development Animation" />
      </div>
    </div>
    
    <div class="column column-right">
      <div class="slideshow-window">
        <div class="slideshow-slider" id="box3-track">
          <div class="tech-slide">
            <h2>Frontend Development</h2>
            <p>Crafting ultra-responsive user interfaces with flawless interactions, speed optimizations, and clean architecture configurations using modern web tools.</p>
          </div>
          <div class="tech-slide">
            <h2>Backend Systems</h2>
            <p>Building scalable microservices, ironclad security infrastructures, and robust API logic layers designed to manage intensive data pipelines fluidly.</p>
          </div>
          <div class="tech-slide">
            <h2>Database Operations</h2>
            <p>Architecting highly performant schemas and intelligent caching layers ensuring data availability, integrity, and lightning-fast query execution handles.</p>
          </div>
          <div class="tech-slide">
            <h2>Production Tools</h2>
            <p>Deploying reliable automation configurations, continuous optimization monitors, and advanced analytical setups to keep architectures flying safely.</p>
          </div>
        </div>
      </div>
      
      <div class="slide-controls">
        <button class="control-btn active" data-slide="0"><span>Frontend</span></button>
        <button class="control-btn" data-slide="1"><span>Backend</span></button>
        <button class="control-btn" data-slide="2"><span>Database</span></button>
        <button class="control-btn" data-slide="3"><span>Tools</span></button>
      </div>
    </div>
  </div>
</div>

<style>
  .box {
    padding: 1rem;
    background-color: #f0f2f5;
    border: 1px solid #ccc;
    font-weight: 500;
    border-radius: 20px;
  }
  .box-3 {
    width: 100%;
    height: 750px; 
    padding: 0;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    box-sizing: border-box;
    transition: background-image 0.8s ease-in-out; /* Smooth background change from palette */

    .glass-overlay {
      width: 100%;
      height: 100%;
      padding: 2.5rem;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      gap: 1.5rem;
      background: rgba(15, 23, 42, 0.5); 
      backdrop-filter: blur(10px);
      box-sizing: border-box;
      overflow: hidden;
    }

    .column {
      flex: 1;
      min-width: 0; 
      min-height: 0; 
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .column-left {
      justify-content: center;
      padding: 2rem;
      margin-top: -2rem;

      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--theme-accent, #ffaa66); 
        text-shadow: 0 0 15px rgba(255, 170, 102, 0.6);
        transition: color 0.4s ease;
      }

      .theme-text {
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--theme-accent, #ffd1a3); 
        font-weight: 500;
        transition: color 0.4s ease;
      }
    }

    .column-middle {
      justify-content: center;
      align-items: center;
      
      .gif-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        padding: 1rem; 

        img {
          width: 100%;
          height: 100%;
          max-width: 100%;
          max-height: 100%; 
          object-fit: contain;
          object-position: center;
        }
      }
    }

    .column-right {
      display: flex;
      flex-direction: column;
      justify-content: space-between;

      .slideshow-window {
        width: 100%;
        flex: 1;
        overflow: hidden;
        position: relative;
        margin-bottom: -3rem;
      }
      .slideshow-slider {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .tech-slide {
        min-width: 100%;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1rem;
        box-sizing: border-box;
        h2 {
          font-size: 2rem;
          font-weight: 700;
          color: #ffffff;
          margin-bottom: 1.25rem;
          letter-spacing: -0.5px;
        }
        p {
          font-size: 1.05rem;
          line-height: 1.7;
          color: #94a3b8;
        }
      }

      .slide-controls {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
        width: 100%;
        margin-bottom: 8rem;
      }

      .control-btn {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.85rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);

        span {
          position: relative;
          z-index: 2;
          font-size: 0.95rem;
          font-weight: 600;
          color: #94a3b8;
          transition: color 0.3s ease;
        }
        &::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: linear-gradient(135deg, rgba(255, 123, 0, 0.15) 0%, rgba(255, 170, 102, 0.05) 100%);
          opacity: 0;
          transition: opacity 0.3s ease;
          z-index: 1;
        }

        &:hover {
          border-color: rgba(255, 170, 102, 0.4);
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba(255, 123, 0, 0.15);
          span {
            color: #ffffff;
          }
          &::before {
            opacity: 1;
          }
        }

        &.active {
          background: linear-gradient(135deg, var(--theme-accent, #ff7b00) 0%, #ffaa66 100%);
          border-color: transparent;
          box-shadow: 0 0 20px rgba(255, 123, 0, 0.4);
          span {
            color: #ffffff;
            font-weight: 700;
          }
          &:hover {
            transform: none;
            box-shadow: 0 0 25px rgba(255, 123, 0, 0.5);
          }
        }

        &:active {
          transform: translateY(0);
        }
      }
    }
  }
</style>