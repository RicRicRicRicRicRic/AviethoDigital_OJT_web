---
import { IMAGES } from '../../data/assets.js'; 
const partners = IMAGES.partners;
---
<script>
  const phrases = [
    "Smart campaigns, powerful content, real results",
    "Strategic ideas. Engaging stories. Measurable impact.",
    "Bold strategies. Creative execution. Proven success.",
    "Driven by insight. Designed to perform.",
    "Data-powered plans. Story-led content. True influence.",
    "Creative minds. Smart moves. Lasting results.",
  ];
  let currentIndex = 0;
  const textElement = document.getElementById('fading-text');

  if (textElement) {
    setInterval(() => {
      textElement.classList.remove('visible');
      setTimeout(() => {
        currentIndex = (currentIndex + 1) % phrases.length;
        textElement.textContent = phrases[currentIndex];
        textElement.classList.add('visible');
      }, 750); 
    }, 4000);
  }

  const track = document.getElementById('slideshow-track');
  const slides = document.querySelectorAll('.slide');
  let currentSlide = 0;
  if (track && slides.length > 0) {
    setInterval(() => {
      currentSlide = (currentSlide + 1) % slides.length;
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
    }, 3000);
  }
</script>

<div class="box box-1" style={`background-image: url(${IMAGES.heroBg.src});`}>
  <div class="glass-overlay">
    <div class="left-section">          
      <img src={IMAGES.logo.src} alt="company logo" class="logo" />
      <p id="fading-text" class="fade-text visible">Smart campaigns, powerful content, real results</p>
      <button class="cta-button">
        <span>Get Started</span>
      </button>
    </div>

    <div class="right-section">
      <h2 class="section-title">Clients and Partners</h2>
    
      <div class="slideshow-container">
        <div class="slideshow-track" id="slideshow-track">
          {partners.map((partner) => (
            <div class="slide">
              <img src={partner.src} alt="Partner Logo" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .box {
    padding: 1rem;
    background-color: #f0f2f5;
    border: 1px solid #ccc;
    font-weight: 500;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
  }
  .box-1 {
    height: 800px;
    padding: 0;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    margin-top: -1px;

    .glass-overlay {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(10px);
    }

    .left-section {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      margin-left: 6rem;
      margin-top: -5rem;
      flex: 1;

      .logo {
        width: 240px;
        height: auto;
        margin-bottom: -3.5rem;
      }

      .fade-text {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 2.5rem;
        color: #ffaa66;
        text-shadow: 0 0 10px rgba(255, 170, 102, 0.3);
        opacity: 0;
        transition: opacity 0.75s ease-in-out;
        &.visible {
          opacity: 1;
        }
      }

      .cta-button {
        padding: 1rem 2.5rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #ff7b00 0%, #ffaa66 100%);
        border: none;
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(255, 123, 0, 0.4);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        &:hover {
          transform: translateY(-3px);
          box-shadow: 0 8px 25px rgba(255, 123, 0, 0.6);
        }
        &:active {
          transform: translateY(-1px);
        }
      }
    }

    .right-section {
      width: 400px;
      border-radius: 16px;
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      overflow: hidden;
      flex-shrink: 0;
      margin-right: 8rem;

      .section-title {
        font-size: 2rem;
        font-weight: 600;
        color: #ffffff;
        margin: 0 0 2rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        text-align: center;
        white-space: nowrap;
      }

      .slideshow-container {
        width: 280px;
        height: 200px;
        overflow: hidden;
        position: relative;
      }

      .slideshow-track {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .slide {
        width: 100%;
        min-width: 100%;
        height: 100%;
        position: relative;
        flex-shrink: 0;

        img {
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          max-width: 90%;
          max-height: 90%;
          object-fit: contain;
        }
      }
    }
  }
</style>