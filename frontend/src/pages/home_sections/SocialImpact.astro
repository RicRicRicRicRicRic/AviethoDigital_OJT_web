---
import { IMAGES } from '../../data/assets.js';
---
<script>
  const counters = document.querySelectorAll('.stat-number') as NodeListOf<HTMLElement>;
  const speed = 200;

  const animateCounter = (counter: HTMLElement) => {
    const updateCount = () => {
      const target = +(counter.getAttribute('data-target') || 0);
      const count = +counter.innerText.replace(/[^0-9]/g, '');
      const increment = target / speed;

      if (count < target) {
        counter.innerText = Math.ceil(count + increment) + (target >= 1000 ? 'K+' : '+');
        setTimeout(updateCount, 10);
      } else {
        counter.innerText = (target >= 1000 ? (target / 1000) + 'K+' : target + '+');
      }
    };
    updateCount();
  };

  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        counters.forEach(counter => {
          counter.innerText = '0';
          animateCounter(counter);
        });
      }
    });
  }, { threshold: 0.5 });

  const box5 = document.querySelector('.box-5');
  if (box5) statObserver.observe(box5);
</script>

<div class="box box-5">
  <div class="left-section">
    <div class="content-wrapper">
      <div class="Impact-label">Innovate, Create and Connect</div>
      <h2>SOCIAL MEDIA <span>IMPACT</span></h2>
      <p>We craft scroll-stopping stories that turn attention into action — building community, sparking conversation, and driving measurable growth for your brand</p>
      
      <div class="stats-container">
        <div class="stat-item">
          <span class="stat-number" data-target="46000">0</span>
          <span class="stat-label">Facebook Followers</span>
        </div>
        <div class="stat-item">
          <span class="stat-number" data-target="100">0</span>
          <span class="stat-label">Projects Done</span>
        </div>
        <div class="stat-item">
          <span class="stat-number" data-target="50">0</span>
          <span class="stat-label">Happy Clients</span>
        </div>
      </div>

      <ul class="impact-list">
        <li>Consistent brand presence that stays top-of-mind</li>
        <li>Data-driven content that converts audiences into customers</li>
        <li>Platform-native creative built for engagement and reach</li>
      </ul>

      <div class="cta-buttons">
        <a href="#contact" class="btn-primary">Boost my social impact</a>
        <a href="#portfolio" class="btn-secondary">See real results</a>
      </div>
    </div>
  </div>

  <div class="right-section" style={`background-image: url(${IMAGES.heroBg5?.src});`}>
    <div class="social-links">
      <a href="https://www.facebook.com/aviethodigital" aria-label="Facebook"><img src={IMAGES.icon.fb?.src} alt="Facebook" /></a>
      <a href="https://www.instagram.com/aviethodigital" aria-label="Instagram"><img src={IMAGES.icon.ig?.src} alt="Instagram" /></a>
      <a href="https://www.tiktok.com/@aviethodigital" aria-label="TikTok"><img src={IMAGES.icon.tktk?.src} alt="TikTok" /></a>
      <a href="https://www.youtube.com/@aviethodigital" aria-label="YouTube"><img src={IMAGES.icon.yt?.src} alt="YouTube" /></a>
    </div>
  </div>
</div>

<style>
  .box {
    padding: 1rem;
    background-color: #f0f2f5;
    border: 1px solid #ccc;
    font-weight: 500;
    border-radius: 8px;
  }
  .box-5 {
    width: 100%;
    min-height: 700px;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    overflow: hidden;
    gap: 0;
    padding: 0;

    .left-section {
      flex: 0 0 65%;
      width: 65%;
      margin-right: -10%;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      background-color: #252728; 
      position: relative;
      z-index: 2;
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 1) 85%, rgba(0, 0, 0, 0) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 1) 85%, rgba(0, 0, 0, 0) 100%);
      
      .content-wrapper {
        padding: 3rem;
        box-sizing: border-box;
        margin-right: 10rem;

        .stats-container {
          display: flex;
          gap: 3rem;
          margin-top: 3rem;
          padding-bottom: 2rem;
          border-bottom: 1px solid rgba(255, 255, 255, 0.2);

          .stat-item {
            display: flex;
            flex-direction: column;
            
            .stat-number {
              font-size: 2.25rem;
              font-weight: 800;
              color: #ffffff;
              line-height: 1;
              margin-bottom: 0.95rem;
            }
            
            .stat-label {
              font-size: 1rem;
              text-transform: uppercase;
              letter-spacing: 1px;
              color: #ffaa66;
              font-weight: 600;
            }
          }
        }

        .impact-list {
          margin-top: 1.5rem;
          padding-left: 1.2rem;
          color: #94a3b8;
          li { margin-bottom: 0.5rem; &::marker { color: #ffaa66; } }
        }

        .cta-buttons {
          display: flex;
          gap: 1.5rem;
          margin-top: 2.5rem;

          a {
            padding: 0.8rem 1.8rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid #ffaa66;
          }

          .btn-primary {
            background: #ffaa66;
            color: #000;
            &:hover { background: #ffb880; box-shadow: 0 0 15px rgba(255, 170, 102, 0.5); }
          }

          .btn-secondary {
            background: transparent;
            color: #ffaa66;
            &:hover { background: rgba(255, 170, 102, 0.1); box-shadow: 0 0 15px rgba(255, 170, 102, 0.2); }
          }
        }

        .Impact-label {
          display: inline-block;
          width: fit-content;
          padding: 0.5rem 1.25rem;
          font-size: 1.25rem;
          font-weight: 600;
          letter-spacing: 0.5px;
          color: #ffaa66;
          text-transform: uppercase;
          border-radius: 50px;
          margin-bottom: 1.5rem;
          position: relative;
          overflow: hidden;
          background: rgba(255, 170, 102, 0.06);
          backdrop-filter: blur(8px);
          border: 1px solid rgba(255, 170, 102, 0.2);
          &::before {
            content: '';
            position: absolute;
            top: 0; left: -150%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55) 50%, transparent);
            transform: skewX(-25deg);
          }
          &:hover::before { left: 150%; transition: left 0.75s ease-in-out; }
        }
        
        h2 { color: #ffffff; margin-top: 0; font-size: 2.5rem; span { color: #ffaa66; } }
        p { color: #94a3b8; }
      }
    }

    .right-section {
      flex: 0 0 45%;
      width: 45%;
      background-size: cover; 
      background-position: center;
      position: relative;
      z-index: 1;

      &::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(37, 39, 40, 0.4);
        z-index: 2;
      }

      .social-links {
        position: absolute;
        bottom: 2rem;
        right: 2rem;
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        z-index: 3;

        a {
          display: flex;
          padding: 10px;
          border: 2px solid rgba(255, 255, 255, 0.3);
          border-radius: 50%; 
          transition: all 0.3s ease;
          background: #ffab663f;
          img { width: 32px; height: 32px; display: block; }
          &:hover {
            border-color: #ffaa66;
            background: #ffab669c;
            box-shadow: 0 0 15px #ffaa66; 
            transform: scale(1.1);
          }
        }
      }
    }
  }
</style>