---
import Layout from '../layouts/Layout.astro';
import Main from '../components/main_page.astro';

// Import the broken-down sections
import Hero from '../pages/home_sections/Hero.astro';
import Services from '../pages/home_sections/Services.astro';
import WebSolutions from '../pages/home_sections/WebSolutions.astro';
import Team from '../pages/home_sections/Team.astro';
import SocialImpact from '../pages/home_sections/SocialImpact.astro';
import BehindWork from '../pages/home_sections/BehindWork.astro';
---

<Layout>
  <Main>
    <main>
      <div class="div-container">
        <Hero />
        <Services />
        <WebSolutions />
        <Team />
        <SocialImpact />
        <BehindWork />
      </div>
    </main>
  </Main>
</Layout>

<style>
  .div-container {
    display: flex;
    flex-direction: column;
    font-family: 'Poppins', 'Montserrat', 'Outfit', 'Urbanist', system-ui, -apple-system, sans-serif;
  }
</style>