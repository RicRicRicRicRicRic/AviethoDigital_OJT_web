---
import { IMAGES } from '../data/assets.js'; 
import PaletteWidget from './Palette_widget.astro';
---

<div class="div">
  <header class="header">
    <nav>
      <ul class="ul" id="nav-links">
        <li class="li"><a href="/">Home</a></li>
        <li class="li"><a href="/about">About</a></li>
        <li class="li"><a href="/services">Services</a></li>
        <li class="li"><a href="/projects">Our Projects</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-content">
    <slot /> 
  </div>

  <footer class="footer">
    <div class="footer-container">
      <div class="footer-left">
        <img src={IMAGES.logo.src} alt="Company Logo" class="footer-logo" />
        
        <p>Professional digital marketing solutions for businesses of all sizes. From website development to social media management, we help you grow your online presence.</p>
        <h3>CONTACT US</h3>
        <p>📞 +639 783 1987</p>
        <p>📧 marketing.avietho@gmail.com</p>
        <p>📱 <a href="#">Facebook</a></p>
      </div>

      <div class="footer-right">
        <div class="footer-grid">
          <div>
            <h4>Digital PR</h4>
            <p>Online Media Relations<br/>Influencer Marketing<br/>Online Reputation Management<br/>Digital Content Creation<br/>Social Media PR</p>
          </div>
          <div>
            <h4>Social Media</h4>
            <p>Social Media Strategy<br/>Content Creation<br/>Community Management<br/>Analytics & Reporting<br/>Brand Management</p>
          </div>
          <div>
            <h4>Video Production</h4>
            <p>Corporate Videos<br/>Event Videography<br/>Live Streaming<br/>Commercial Production<br/>Post-Production</p>
          </div>
          <div>
            <h4>Web Development</h4>
            <p>Website Design<br/>Frontend Development<br/>Backend Development<br/>E-commerce Solutions<br/>SEO & Analytics</p>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2025 Avietho Digital Marketing. All rights reserved.</p>
    </div>
  </footer>

  <PaletteWidget />
</div>

<script>
  const currentPath = window.location.pathname;
  const links = document.querySelectorAll('#nav-links a');
  
  links.forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      const parent = link.parentElement;
      if (parent) {
        parent.classList.add('active');
      }
    }
  });
</script>

<style is:global>
  :root {
    --theme-bg: #000000;
    --theme-accent: #FFBC85;
    --theme-active: #FFBC85BF;
  }

  .div { font-family: 'Montserrat', 'Futura', 'Century Gothic', sans-serif; }

  .header { 
    padding: 2rem 3rem; 
    background-color: var(--theme-bg); 
    position: sticky; 
    top: 0; 
    z-index: 100; 
    display: flex; 
    justify-content: center; 

    .ul { 
      list-style: none; 
      display: flex; 
      gap: 2rem; 
      margin: 0; 
      padding: 0; 

      .li {
        position: relative;
        padding: 10px 20px;
        border-radius: 12px;
        transition: all 0.4s ease;

        a { 
          text-decoration: none; 
          color: var(--theme-accent); 
          font-weight: 600; 
          font-size: 20px;
          transition: color 0.3s ease;
        }

        &.active {
          background: var(--theme-active); 
          backdrop-filter: blur(10px); 
          border: 1px solid rgba(255, 255, 255, 0.2);
          overflow: hidden;
          
          a { color: #ffffff; }

          &::before {
            content: '';
            position: absolute;
            top: 0;
            left: -150%;
            width: 200%; 
            height: 100%;
          
            background: linear-gradient(
              120deg, 
              transparent 0%, 
              rgba(255, 255, 255, 0) 30%, 
              rgba(255, 255, 255, 0.5) 50%, 
              rgba(255, 255, 255, 0) 70%, 
              transparent 100%
            );
            animation: shine 6s infinite;
          }
        }
      }
    }
  }

  @keyframes shine {
    100% { left: 100%; }
  }

  .footer { 
    background: var(--theme-bg); 
    color: #ffffff; 
    padding: 4rem 2rem 2rem 2rem; 
    margin-top: auto; 

    .footer-container { 
      max-width: 1200px; 
      margin: 0 auto; 
      display: flex; 
      flex-direction: row; 
      gap: 4rem; 
      margin-bottom: 3rem; 

      .footer-left { 
        flex: 0 0 30%; 

        .footer-logo { 
          display: block;
          width: 75px;       
          max-width: 100%;    
          height: auto;       
          margin-bottom: -1.5rem; 
        }
      }

      .footer-right { 
        flex: 0 0 70%; 

        .footer-grid { 
          display: grid; 
          grid-template-columns: repeat(4, 1fr); 
          gap: 1.5rem; 
        }
      }
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 0 auto;
      padding-top: 2rem;
      border-top: 1px solid #ffffff;
      text-align: center;
      font-size: 0.8rem;
      opacity: 0.8;
    }

    h3, h4 { color: var(--theme-accent); }
    p { font-size: 0.85rem; line-height: 1.6; }
    a { color: #ffffff; text-decoration: none; }
  }
</style>