---
import { IMAGES } from '../data/assets.js'; 
import PaletteWidget from './Palette_widget.astro';
---

<div class="div">
  <header class="header">
    <nav>
      <ul class="ul" id="nav-links">
        <li class="li"><a href="/" class="nav-link">Home</a></li>
        <li class="li"><a href="/about" class="nav-link">About</a></li>
        <li class="li"><a href="/services" class="nav-link">Services</a></li>
        <li class="li"><a href="/projects" class="nav-link">Our Projects</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-content">
    <slot /> 
  </div>

  <footer class="footer">
    <div class="footer-container">
      <div class="footer-left">
        <img src={IMAGES.logo.src} alt="Company Logo" class="footer-logo" />
        <p>Professional digital marketing solutions for businesses of all sizes. From website development to social media management, we help you grow your online presence.</p>
        <h3>CONTACT US</h3>
        <p>📞 +639 783 1987</p>
        <p>📧 marketing.avietho@gmail.com</p>
        <p>📱 <a href="#">Facebook</a></p>
      </div>

      <div class="footer-right">
        <div class="footer-grid">
          <div>
            <h4>Digital PR</h4>
            <p>Online Media Relations<br/>Influencer Marketing<br/>Online Reputation Management<br/>Digital Content Creation<br/>Social Media PR</p>
          </div>
          <div>
            <h4>Social Media</h4>
            <p>Social Media Strategy<br/>Content Creation<br/>Community Management<br/>Analytics & Reporting<br/>Brand Management</p>
          </div>
          <div>
            <h4>Video Production</h4>
            <p>Corporate Videos<br/>Event Videography<br/>Live Streaming<br/>Commercial Production<br/>Post-Production</p>
          </div>
          <div>
            <h4>Web Development</h4>
            <p>Website Design<br/>Frontend Development<br/>Backend Development<br/>E-commerce Solutions<br/>SEO & Analytics</p>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2025 Avietho Digital Marketing. All rights reserved.</p>
    </div>
  </footer>

  <PaletteWidget />
</div>

<script>
  const currentPath = window.location.pathname;
  const links = document.querySelectorAll('#nav-links a');
  
  links.forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
    }
  });
</script>

<style is:global>
  :root {
    --theme-bg: #000000;
    --theme-accent: #FFBC85;
    --theme-active: #FFBC85BF;
  }

  .div { font-family: 'Montserrat', sans-serif; min-height: 100vh; display: flex; flex-direction: column; }

  /* Navbar Styles */
  .header { padding: 2rem 3rem; background-color: var(--theme-bg); position: sticky; top: 0; z-index: 100; display: flex; justify-content: center; }
  .ul { list-style: none; display: flex; gap: 3rem; margin: 0; padding: 0; }
  
  .nav-link {
    text-decoration: none;
    color: #ffffff;
    font-weight: 500;
    font-size: 1.25rem;
    position: relative;
    padding-bottom: 5px;
    transition: color 0.3s ease;
  }

  /* Animated Underline Effect */
  .nav-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--theme-accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after, .nav-link.active::after { width: 100%; }
  .nav-link:hover { color: var(--theme-accent); }

  /* Footer Styles */
  .footer { background: var(--theme-bg); color: #ffffff; padding: 4rem 2rem 2rem 2rem; margin-top: auto; }
  .footer-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 4rem; margin-bottom: 3rem; }
  .footer-left { flex: 0 0 30%; }
  .footer-logo { display: block; width: 75px; height: auto; margin-bottom: 1rem; }
  .footer-right { flex: 1; }
  .footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .footer-bottom { text-align: center; border-top: 1px solid #333; padding-top: 2rem; }
</style>