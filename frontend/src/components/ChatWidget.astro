    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: grab;
    user-select: none;
    font-weight: 600;
  }

  #chat-close-btn {
    background: none;
    border: none;
    color: white;
    font-size: 20px;
    cursor: pointer;
    padding: 0 4px;
    line-height: 1;
  }

  #chat-messages {
    flex: 1;
    padding: 12px;
    overflow-y: auto;
    background: #f9f9f9;
